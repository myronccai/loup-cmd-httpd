@mode(host.dual)

# Application identity for httpd. Keep APP_NAME and APP_VERSION in step
# with `name` and `version` in package.lppkg.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# bin/httpd.lpscr, lib/handler and lib/usage import it under `loup-bootstrap
# run`, and the handler's tests under `loup-bootstrap test`. Nothing in this
# project compiles it.

pub const APP_NAME: string = "httpd";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Serve the files under a directory over HTTP.";

# The Server header of every response.
pub const SERVER: string = "loup-cmd-httpd/0.1.0";

# Exit statuses.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
