@mode(host.dual)

# The HTML page that httpd sends for a directory without an index.html.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0: lib/handler
# imports it, so it runs with bin/httpd.lpscr under `loup-bootstrap run`, and
# with tests/listing_test.lpscr and tests/handler_test.lpscr under
# `loup-bootstrap test`. Nothing in this project compiles it, and it needs
# Stage0: a native build refuses template fences, and the self-hosted
# `loup run` has no interpolation filters.
#
# Structure: sorted_entries() puts the entries in order, href() and label()
# give an entry's link and its text, and listing_page() fills an `(html)`
# template fence with them.

from data.query import (percentEncode);

pub struct Entry {
    pub name: string;
    pub is_dir: bool;
}

func compare_text(a: string, b: string): int {
    return if (a < b) { -1 } else if (a > b) { 1 } else { 0 };
}

# Directories first, then files; each group by name.
pub func sorted_entries(entries: list[Entry]): list[Entry] {
    var out: list[Entry] = [];
    for (e in entries) {
        out.push(e);
    }
    out.sort(func(a: Entry, b: Entry): int {
        if (a.is_dir != b.is_dir) {
            return if (a.is_dir) { -1 } else { 1 };
        }
        return compare_text(a.name, b.name);
    });
    return out;
}

# An entry's link, relative to the listed directory: the name
# percent-encoded, and a `/` after a directory's.
pub func href(e: Entry): string {
    let suffix = if (e.is_dir) { "/" } else { "" };
    return percentEncode(e.name, "") + suffix;
}

# An entry's text in the listing: the name, and a `/` after a directory's.
pub func label(e: Entry): string {
    return if (e.is_dir) { e.name + "/" } else { e.name };
}

# The listing of the directory at URL path `url_path` (ends with `/`). The
# links are relative to it: an entry's name, or `../` for the parent.
#
# The page is an `(html)` template fence. An html fence does not escape what
# it inserts in Loup 1.26.0, so the path and the names, which come from the
# request and the file system, go through the `escape` filter (`&`, `<`,
# `>`, `"` and `'`). A directive on a line of its own would leave a blank
# line in the page, so each `{% ... %}` starts the line it controls and the
# next line starts with its `{% end %}`.
pub func listing_page(url_path: string, entries: list[Entry]): string {
    let page = ```(html):(none)
    <!DOCTYPE html>
    <html>
    <head><meta charset="utf-8"><title>Index of {$ url_path | escape $}</title></head>
    <body>
    <h1>Index of {$ url_path | escape $}</h1>
    <ul>
    {% if (url_path != "/") %}<li><a href="../">../</a></li>
    {% end %}{% for (e in sorted_entries(entries)) %}<li><a href="{$ href(e) $}">{$ label(e) | escape $}</a></li>
    {% end %}</ul>
    </body>
    </html>
    ```;
    # The rendered fence stops at `</html>`; the page ends with a newline.
    return page.render({}) + "\n";
}
