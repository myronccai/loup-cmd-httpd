@mode(host.dual)

# Command-line parsing for httpd, by hand (Loup 1.26 has no CLI library).
#
# Grammar: httpd [OPTION]... [DIR]
#   Value options take `-p 8000`, `-p8000`, `--port 8000` or `--port=8000`;
#   short flags combine (`-qp8000`). Options may follow DIR; `--` ends the
#   options.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# bin/httpd.lpscr imports it under `loup-bootstrap run` and
# tests/args_test.lpscr under `loup-bootstrap test`. Nothing in this project
# compiles it, and it needs Stage0: the `in` operator works only there in
# Loup 1.26.0.
#
# Structure: the value checks (parse_port, is_bind_address) and
# split_option(), then parse_args(), which makes one pass over the words.
# split_option() cuts each option word into a name and an attached value
# (`--port=8000`, `-p8000`); a value option without one takes the next
# word. An if-chain then handles the name, and the tail of a short-flag
# cluster is put back in `pending` to be read as an option of its own.
# Option errors use GNU getopt's wording.

from core.string_utils import (isDigits);
from net.addressing import (Host, IpAddr, AddressingError);

pub const DEFAULT_PORT: int = 8080;
pub const DEFAULT_HOST: string = "127.0.0.1";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub port: int;
    pub host: string;
    pub quiet: bool;
    pub root: string;
}

# A TCP port: a whole number from 1 to 65535.
pub func parse_port(value: string): int? {
    if (!isDigits(value) or value.len() > 5) {
        return None;
    }
    let n = value.toInt();
    return if (n >= 1 and n <= 65535) { Some(n) } else { None };
}

# Whether `text` can be the address to listen on: an IPv4 or IPv6 address
# (`::1`, also in brackets), or a well-formed host name, which the system
# resolves when the server binds (`localhost`). A malformed one is a usage
# error here rather than a failure to listen later.
pub func is_bind_address(text: string): bool {
    if (IpAddr.isValid(text)) {
        return true;
    }
    try {
        let _ = Host.parse(text);
        return true;
    } catch (AddressingError) {
        return false;
    }
}

# An option word as its name and the value attached to it, if any:
# `--port=8000` is ("--port", "8000") and `-p8000` is ("-p", "8000").
pub func split_option(arg: string): (string, string?) {
    if (arg.startsWith("--")) {
        let eq = arg.index_of("=");
        if (eq >= 0) {
            return (arg.slice(0, eq), Some(arg.slice(eq + 1)));
        }
        return (arg, None);
    }
    if (arg.len() > 2) {
        return (arg.slice(0, 2), Some(arg.slice(2)));
    }
    return (arg, None);
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var port = DEFAULT_PORT;
    var host = DEFAULT_HOST;
    var quiet = false;
    var dirs: list[string] = [];
    var only_operands = false;
    # The rest of a short-option cluster, as an option of its own (`-qV` →
    # `-q`, then `-V`).
    var pending = "";

    var i = 0;
    while (i < argv.len() or pending.len() > 0) {
        var arg = pending;
        if (pending.len() > 0) {
            pending = "";
        } else {
            arg = argv[i];
            i += 1;
        }
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            dirs.push(arg);
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }

        let (name, attached) = split_option(arg);
        var value = attached;
        let takes_value = name in ["-p", "--port", "-b", "--bind"];
        if (takes_value and value.is_none()) {
            if (i >= argv.len()) {
                return Err(if (arg.startsWith("--")) { i"option '{$ name $}' requires an argument" } else { i"option requires an argument -- '{$ name.slice(1) $}'" });
            }
            value = Some(argv[i]);
            i += 1;
        }

        # Value options first; then an attached value on any other name, which
        # is an error for a long option and the rest of a cluster for a short
        # flag; then the plain flags.
        if (name == "-p" or name == "--port") {
            let text = value.unwrap_or("");
            port = match parse_port(text) {
                Some(n) => n,
                None => { return Err(i"invalid port '{$ text $}'"); },
            };
        } else if (name == "-b" or name == "--bind") {
            host = value.unwrap_or("");
            if (host.len() == 0) {
                return Err("empty bind address");
            }
            if (!is_bind_address(host)) {
                return Err(i"invalid bind address '{$ host $}'");
            }
        } else if (value.is_some() and arg.startsWith("--")) {
            if (name in ["--quiet", "--help", "--version"]) {
                return Err(i"option '{$ name $}' doesn't allow an argument");
            }
            return Err(i"unrecognized option '{$ arg $}'");
        } else if (value.is_some() and name in ["-q", "-h", "-V"]) {
            # A flag followed by more letters: take the flag, then the rest.
            pending = "-" + value.unwrap();
            if (name == "-q") {
                quiet = true;
            } else if (name == "-h") {
                help = true;
            } else {
                version = true;
            }
        } else if (value.is_some()) {
            return Err(i"invalid option -- '{$ arg.slice(1, 2) $}'");
        } else if (name == "-q" or name == "--quiet") {
            quiet = true;
        } else if (name == "-h" or name == "--help") {
            help = true;
        } else if (name == "-V" or name == "--version") {
            version = true;
        } else if (name.startsWith("--")) {
            return Err(i"unrecognized option '{$ arg $}'");
        } else {
            return Err(i"invalid option -- '{$ name.slice(1) $}'");
        }
    }

    if (dirs.len() > 1) {
        return Err(i"extra operand '{$ dirs[1] $}'");
    }
    return Ok(Options(
        help = help,
        version = version,
        port = port,
        host = host,
        quiet = quiet,
        root = if (dirs.len() == 1) { dirs[0] } else { "." },
    ));
}
