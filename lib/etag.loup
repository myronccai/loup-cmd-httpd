@mode(host.dual)

# Entity tags for httpd's conditional GET. io.fs has no stat() in Loup 1.26,
# so there is no modification time for Last-Modified; the tag is a hash of
# the content instead.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0: lib/handler
# imports it, so it runs with bin/httpd.lpscr under `loup-bootstrap run`, and
# with tests/etag_test.lpscr and tests/handler_test.lpscr under
# `loup-bootstrap test`. Nothing in this project compiles it. fnv1a() needs
# Stage0: the self-hosted `loup run` ignores @overflowWrapping and stops at
# the first multiplication that overflows.

from system.text import (padStart);

let HEX: string = "0123456789abcdef";

func hex(n: int, width: int): string {
    var out = "";
    var v = n;
    while (v > 0) {
        out = HEX.slice(v % 16, v % 16 + 1) + out;
        v = v / 16;
    }
    return padStart(out, width, "0");
}

# 32-bit FNV-1a of the bytes. The hash is defined on 32-bit arithmetic that
# wraps, which is what uint32 under @overflowWrapping does (without the
# annotation, an overflowing uint32 multiplication throws).
@overflowWrapping
pub func fnv1a(data: bytes): int {
    var h: uint32 = 2166136261u32;
    for (i in 0..data.len()) {
        h ^= data[i] as uint32;
        h *= 16777619u32;
    }
    return h as int;
}

# `"<length in hex>-<FNV-1a in hex>"`, quoted as the header needs.
pub func etag_of(data: bytes): string {
    return "\"" + hex(data.len(), 1) + "-" + hex(fnv1a(data), 8) + "\"";
}

# Whether an If-None-Match header value names `tag`: `*`, or a
# comma-separated list of tags, weak (`W/"..."`) or strong.
pub func etag_matches(header: string, tag: string): bool {
    for (raw in header.split(",")) {
        var candidate = raw.trim();
        if (candidate.startsWith("W/")) {
            candidate = candidate.slice(2);
        }
        if (candidate == "*" or candidate == tag) {
            return true;
        }
    }
    return false;
}
