@mode(host.dual)

# httpd's access log: one line per request in Combined Log Format, which
# loup-cmd-logwatch reads:
#   - - - [20/Oct/2026:09:15:02 +0000] "GET /docs/ HTTP/1.1" 200 412 "-" "curl/8.9.1"
# net.http does not give the handler the client's address, so the host field
# is `-`.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# bin/httpd.lpscr imports it under `loup-bootstrap run` and
# tests/accesslog_test.lpscr under `loup-bootstrap test`. Nothing in this
# project compiles it.

from net.http import (Request, Response);
from core.datetime import (DateTime);
from system.text import (padStart);

let MONTHS: list[string] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

func pad2(n: int): string {
    return padStart(str(n), 2, "0");
}

# `20/Oct/2026:09:15:02 +0000` for seconds since 1970 (UTC).
pub func clf_time(epoch_seconds: int): string {
    let t = DateTime.utcFromTimestamp(epoch_seconds as float);
    return pad2(t.day) + "/" + MONTHS[t.month - 1] + "/" + str(t.year) + ":" + pad2(t.hour) + ":" + pad2(t.minute) + ":" + pad2(t.second) + " +0000";
}

# A quoted log field: `"` and `\` escaped, `-` for an empty value.
func quoted(text: string): string {
    let value = if (text.len() == 0) { "-" } else { text };
    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
}

pub func log_line(req: Request, resp: Response, epoch_seconds: int): string {
    let size = resp.body.byteLength();
    let request = req.method + " " + req.target + " " + req.version.toString();
    let fields = [
        "- - -",
        "[" + clf_time(epoch_seconds) + "]",
        quoted(request),
        str(resp.status),
        if (size == 0) { "-" } else { str(size) },
        quoted(req.header("Referer") ?? ""),
        quoted(req.header("User-Agent") ?? ""),
    ];
    return fields.join(" ");
}
