#!/usr/bin/env -S loup-bootstrap run --deny-all --allow-fs --allow-net
@mode(host.scripted)

# httpd: serve the files under a directory over HTTP.
#
# Runtime: host.scripted. Stage0 interprets this file from source with
# `loup-bootstrap run --deny-all --allow-fs --allow-net bin/httpd.lpscr --
# ARGS`: the shebang line, `make run`, tests/e2e.sh and the CI smoke test all
# run it that way. Its top-level statements run in order and there is no
# compile step. The flags grant the `fs` and `net` capabilities and nothing
# else, and Stage0 enforces them. The self-hosted `loup run` cannot run it on
# Linux x86-64: it has no network support.
#
# Structure: this script is the program's top level. It parses the command
# line (a usage error exits 2), answers --help and --version, checks that
# DIR is a directory, then hands net.http's serve() a handler that answers
# each request with lib/handler's respond() and writes its access log line
# (lib/accesslog). serve() comes back only by throwing, when it cannot listen.

from net.http import (Request, Response, serve);
from io.fs import (isDir);
from system.time import (realtimeNs);
from ..lib.appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from ..lib.args import (Options, parse_args);
from ..lib.usage import (usage, version_line);
from ..lib.handler import (respond);
from ..lib.accesslog import (log_line);

let parsed = parse_args(args());
if (parsed.is_err()) {
    printErr(i"{$ APP_NAME $}: {$ parsed.unwrap_err() $}");
    printErr(i"Try '{$ APP_NAME $} --help' for more information.");
    exit(EXIT_USAGE);
}
let opts: Options = parsed.unwrap();
if (opts.help) {
    println(usage());
    exit(EXIT_OK);
}
if (opts.version) {
    println(version_line());
    exit(EXIT_OK);
}
if (!isDir(opts.root)) {
    printErr(i"{$ APP_NAME $}: {$ opts.root $}: not a directory");
    exit(EXIT_FAILURE);
}

let root = opts.root;
let quiet = opts.quiet;
# Messages go to standard error: standard output carries only the access log.
printErr(i"{$ APP_NAME $}: serving {$ root $} on http://{$ opts.host $}:{$ opts.port $}/");
try {
    # Serves one connection at a time, forever.
    serve(opts.host, opts.port, func(req: Request): Response {
        let resp = respond(root, req);
        if (!quiet) {
            println(log_line(req, resp, realtimeNs() / 1000000000));
        }
        return resp;
    });
} catch (IoError as e) {
    printErr(i"{$ APP_NAME $}: cannot listen on {$ opts.host $}:{$ opts.port $}: {$ e.message $}");
    exit(EXIT_FAILURE);
}
