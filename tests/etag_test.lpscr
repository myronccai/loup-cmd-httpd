@mode(host.scripted)

# Unit tests for httpd's entity tags (lib/etag.loup): the FNV-1a hash
# (published test vectors and a fixture file, so every multiplication
# wraps), the tag's format, and If-None-Match matching.
#
# Runtime: host.scripted, run by the test runner: `make test` interprets this
# file with Stage0, one file and one test at a time
# (`loup-bootstrap test --no-parallel --file tests/etag_test.lpscr`), one test
# per `func test_*()`. It imports lib/ by relative path (`from ..lib.etag`),
# reads tests/fixtures/site (make runs it from the repository root) and opens
# no socket; it is not part of the program.

from debug.assert import (expect, expectEq);
from ..lib.etag import (fnv1a, etag_of, etag_matches);

let DATA: bytes = readBytes("tests/fixtures/site/style.css");

# The expected value was computed with an independent FNV-1a implementation.
func test_fnv1a(): void {
    expectEq(fnv1a(DATA), 0x3cd12149, "style.css");
    expect(fnv1a(DATA) != fnv1a(readBytes("tests/fixtures/site/app.js")), "another file differs");
}

# Vectors from the FNV reference: the offset basis for no input.
func test_fnv1a_vectors(): void {
    expectEq(fnv1a(b""), 0x811c9dc5, "empty");
    expectEq(fnv1a(b"a"), 0xe40c292c, "a");
    expectEq(fnv1a(b"foobar"), 0xbf9cf968, "foobar");
}

func test_etag_format(): void {
    expectEq(etag_of(DATA), "\"22-3cd12149\"", "length and hash in hex");
}

func test_etag_matches(): void {
    let tag = "\"22-3cd12149\"";
    expect(etag_matches(tag, tag), "same");
    expect(etag_matches("\"x\", " + tag, tag), "in a list");
    expect(etag_matches("W/" + tag, tag), "weak");
    expect(etag_matches("*", tag), "any");
    expect(!etag_matches("\"other\"", tag), "different");
}
